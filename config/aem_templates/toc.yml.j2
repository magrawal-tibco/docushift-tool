{#-
  The version's navigation (Stage 6a). `rows` arrives flattened, each row carrying
  the indent its depth needs, because a template that recurses gets its own
  indentation wrong silently -- the YAML still parses, into a different tree.
  Every scalar goes through `| yaml`, the same unconditional double-quote csh.yml
  uses: a title holding a colon is ordinary prose here, not a mapping.

  The keys are html-to-md's -- `docs_list_title` / `docs` / `url` /
  `subfolderlist` -- by the user's call in Phase 36, and so is `list_title`'s
  value (`Online Help`). The tree under them is DocuShift's own.
-#}
# AEM table of contents{% if title %} for {{ title }}{% endif %}
# Generated by DocuShift (Stage 6) -- do not edit by hand.
docs_list_title: {{ list_title | yaml }}
docs:
{%- for row in rows %}
{{ row.indent }}- title: {{ row.title | yaml }}
{%- if row.path %}
{{ row.indent }}  url: {{ row.path | yaml }}
{%- endif %}
{%- if row.children %}
{{ row.indent }}  subfolderlist:
{%- endif %}
{%- endfor %}
