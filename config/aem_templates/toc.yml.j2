version: "1.0"
product: "{{ product.product_code }}"
product_version: "{{ version.version }}"
items:
{%- for guide in guides %}
  - title: "{{ guide.title }}"
    path: "{{ guide.path }}"
    {%- if guide.children %}
    children:
    {%- for topic in guide.children recursive %}
      - title: "{{ topic.title }}"
        path: "{{ topic.path }}"
        {%- if topic.children %}
        children:
{{ loop(topic.children) | indent(8, true) }}
        {%- endif %}
    {%- endfor %}
    {%- endif %}
{%- endfor %}
